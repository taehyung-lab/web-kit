{
  "openapi": "3.0.3",
  "info": {
    "title": "admin-web-starter sample API",
    "version": "0.1.0",
    "description": "스타터의 예시 계약. 실제 서버 명세로 교체한다. 모든 응답은 Spring 봉투 { header: { resultCode, resultMessage }, data }이며 resultCode 200만 성공이다."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "products"
    }
  ],
  "paths": {
    "/api/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "signIn",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공. refresh 토큰은 httpOnly 쿠키로 내려온다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패. data는 필드 오류 목록이다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/reissue": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "reissueToken",
        "security": [],
        "description": "refresh 쿠키로 새 access 토큰을 발급한다. 401이면 재발급 불가(세션 종료).",
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "signOut",
        "security": [],
        "description": "클라이언트가 캡처한 access 토큰을 Authorization 헤더에 직접 실어 보낸다.",
        "responses": {
          "200": {
            "description": "로그아웃",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "products"
        ],
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "이름·코드 부분 일치"
          },
          {
            "name": "status",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ProductStatus"
              }
            },
            "description": "반복 키(status=A&status=B)"
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "분류 ID(GET /api/categories의 categoryId)"
          },
          {
            "name": "createdFrom",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "createdTo",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "0부터 시작"
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Spring 형식 \"필드,asc|desc\""
          }
        ],
        "responses": {
          "200": {
            "description": "목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPageEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패. data는 필드 오류 목록이다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "products"
        ],
        "operationId": "createProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpsertRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "등록 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패. data는 필드 오류 목록이다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{productId}": {
      "get": {
        "tags": [
          "products"
        ],
        "operationId": "getProduct",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "상세",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "대상 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "products"
        ],
        "operationId": "updateProduct",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpsertRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패. data는 필드 오류 목록이다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "대상 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/deactivate": {
      "post": {
        "tags": [
          "products"
        ],
        "operationId": "deactivateProducts",
        "description": "여러 상품을 비활성화한다. 업무 규칙으로 거절하면 HTTP 200 봉투에 200이 아닌 resultCode가 온다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeactivateProductsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "처리 결과 또는 업무 거절",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeactivateResultEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패. data는 필드 오류 목록이다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "categories"
        ],
        "operationId": "listCategories",
        "description": "상품 분류 선택지. 목록 필터와 등록·수정 폼이 쓴다.",
        "responses": {
          "200": {
            "description": "분류 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ResultHeader": {
        "type": "object",
        "required": [
          "resultCode",
          "resultMessage"
        ],
        "properties": {
          "resultCode": {
            "type": "integer",
            "format": "int32"
          },
          "resultMessage": {
            "type": "string"
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "validCode"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "validCode": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "nullable": true,
            "type": "object"
          }
        }
      },
      "EmptyEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "nullable": true,
            "type": "object"
          }
        }
      },
      "FieldErrorEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "loginId",
          "password"
        ],
        "properties": {
          "loginId": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Token": {
        "type": "object",
        "required": [
          "accessToken"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          }
        }
      },
      "TokenEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "$ref": "#/components/schemas/Token"
          }
        }
      },
      "ProductStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "ACTIVE",
          "INACTIVE"
        ]
      },
      "ProductSummary": {
        "type": "object",
        "required": [
          "productId",
          "name",
          "code",
          "status",
          "categoryId",
          "price",
          "createdAt"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatus"
          },
          "price": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "categoryId": {
            "type": "string"
          }
        }
      },
      "ProductPage": {
        "type": "object",
        "required": [
          "content",
          "totalElements"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            }
          },
          "totalElements": {
            "type": "integer"
          }
        }
      },
      "ProductPageEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "$ref": "#/components/schemas/ProductPage"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "productId",
          "name",
          "code",
          "status",
          "categoryId",
          "price",
          "stock",
          "createdAt",
          "updatedAt",
          "options"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatus"
          },
          "price": {
            "type": "integer"
          },
          "stock": {
            "type": "integer"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "categoryId": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/ProductOption"
            }
          }
        }
      },
      "ProductEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductUpsertRequest": {
        "type": "object",
        "required": [
          "name",
          "code",
          "status",
          "categoryId",
          "price",
          "stock",
          "options"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{3,20}$",
            "description": "중복 불가(400 field=code, validCode=DUPLICATE)"
          },
          "status": {
            "$ref": "#/components/schemas/ProductStatus"
          },
          "price": {
            "type": "integer",
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "categoryId": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/ProductOption"
            }
          }
        }
      },
      "DeactivateProductsRequest": {
        "type": "object",
        "required": [
          "productIds"
        ],
        "properties": {
          "productIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeactivateResult": {
        "type": "object",
        "required": [
          "deactivatedCount"
        ],
        "properties": {
          "deactivatedCount": {
            "type": "integer"
          }
        }
      },
      "DeactivateResultEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "$ref": "#/components/schemas/DeactivateResult"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "categoryId",
          "name"
        ],
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CategoryListEnvelope": {
        "type": "object",
        "required": [
          "header",
          "data"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ResultHeader"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "ProductOption": {
        "type": "object",
        "required": [
          "name",
          "extraPrice"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "extraPrice": {
            "type": "integer",
            "minimum": 0,
            "description": "원 단위 추가금액"
          }
        }
      }
    }
  }
}
